# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the SANITIZED example must be versioned (it documents every variable)
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# A bare `test` pattern matches ANY file or directory named `test` at any
# depth, so git silently ignored real source: src/app/api/providers/[id]/test/
# (the provider "Test connection" route) never made it into the repository or
# an export archive. The scratch names are anchored to the project root instead.
/test
/prompt

server.log
# Skills directory
/skills/
# runtime state: the SQLite database, the generated secret key / desktop token
db/
prisma/db/
