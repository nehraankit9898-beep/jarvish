# ---------------------------------------------------------------------------
# AgentScope Suite — JARVIS · SANITIZED EXAMPLE ENVIRONMENT
#
# Copy this file to `.env` (`npm run setup` does it for you and generates a
# random AGENTSCOPE_SECRET_KEY). NOTHING here is a real credential, and every
# value below can be left at its default.
#
# `.env` is git-ignored on purpose: it holds the encryption key for the stored
# provider keys. Never commit it and never paste real keys into this file.
# ---------------------------------------------------------------------------

# --- required -------------------------------------------------------------
# SQLite file used by Prisma. The path is resolved relative to `studio/prisma/`
# ("file:../db/custom.db" → studio/db/custom.db).
DATABASE_URL="file:../db/custom.db"

# Master key for the AES-256-GCM encryption of provider API keys at rest.
# `npm run setup` generates a random 64-hex-char value. If it is lost, the
# stored provider keys cannot be decrypted (re-enter them in the UI).
AGENTSCOPE_SECRET_KEY=""

# --- access control (set these before exposing the Studio to a network) ----
# When set, every mutating API call must send `x-agentscope-token: <value>` or
# `Authorization: Bearer <value>`. In production the agentic routes FAIL CLOSED
# until this is configured.
# AGENTSCOPE_API_TOKEN=""
# Local-only escape hatch. Leave unset unless you accept an unauthenticated API
# on this machine.
# AGENTSCOPE_ALLOW_UNAUTHENTICATED=""
# Comma-separated extra origins allowed to POST to the API (same-origin is
# always allowed). Needed only when a SEPARATE front-end drives this server.
# AGENTSCOPE_ALLOWED_ORIGINS="https://studio.example.com"
# Public base URL (OAuth redirects, links in notifications).
# AGENTSCOPE_PUBLIC_URL="http://localhost:3000"

# --- laptop control -------------------------------------------------------
# locked  — the agent cannot touch the machine (only host.info)
# ask     — reads run; every write / command / delete / launch needs approval
# trusted — review-class actions inside AGENTSCOPE_HOST_TRUSTED_DIRS run freely
# Destructive actions ALWAYS require approval; blocked paths never run.
AGENTSCOPE_HOST_MODE="ask"
# Colon/semicolon-separated list (platform path separator) of trusted folders.
# AGENTSCOPE_HOST_TRUSTED_DIRS=""
# Mouse / keyboard / screen bridge: locked (default) | ask | trusted.
# Requires: pip install -r python-bridge/requirements-desktop.txt
AGENTSCOPE_DESKTOP_MODE="locked"
# AGENTSCOPE_DESKTOP_PORT="8791"
# AGENTSCOPE_KILL_HOTKEY="ctrl+shift+f12"
# Extra folders the file tools may reach (path-separator separated).
# AGENTSCOPE_ALLOWED_ROOTS=""

# --- voice ---------------------------------------------------------------
# Browser speech recognition works without any Python. The Python voice bridge
# adds local wake-word detection + local TTS; install its requirements first:
#   pip install -r python-bridge/requirements-voice.txt
# AGENTSCOPE_VOICE_BRIDGE="1"
# AGENTSCOPE_VOICE_PORT="8792"
# AGENTSCOPE_PYTHON="python3"
# AGENTSCOPE_WAKE_MODEL_DIR=""
# AGENTSCOPE_PORCUPINE_KEY=""

# --- browser / downloads -------------------------------------------------
# Let the automation browser reach loopback addresses (dev servers). OFF by
# default because it is an SSRF surface.
# AGENTSCOPE_BROWSER_ALLOW_LOOPBACK="0"
# AGENTSCOPE_DOWNLOADS_DIR=""
# AGENTSCOPE_DOWNLOADS_WATCH="1"
# AGENTSCOPE_DOWNLOAD_MAX_MB="200"

# --- providers -----------------------------------------------------------
# Provider keys are normally entered in the UI (encrypted at rest). The env
# fallbacks below are read as a last resort, in this order of preference:
# OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_API_KEY or GEMINI_API_KEY /
# DEEPSEEK_API_KEY / DASHSCOPE_API_KEY or QWEN_API_KEY / MOONSHOT_API_KEY /
# XAI_API_KEY / OPENROUTER_API_KEY / GROQ_API_KEY / NVIDIA_API_KEY /
# ZAI_API_KEY
# Allow "Test connection"/chat to reach a LOCAL model server (Ollama, LM Studio
# on 127.0.0.1). Set to 0 to forbid loopback entirely.
AGENTSCOPE_PROVIDER_ALLOW_LOOPBACK="1"

# --- background runtime --------------------------------------------------
# The Studio server normally owns the ticker. "external" hands the schedules
# to the standalone worker (`npm run worker`) so the server never ticks twice;
# "0" disables background work completely (tests/dev).
# AGENTSCOPE_BACKGROUND_RUNTIME=""
# AGENTSCOPE_WORKER_LOCK=""

# --- retention (opt-in) --------------------------------------------------
# Delete audit rows / agent messages / streamed events older than N days.
# 0 or unset = keep everything (default). Security audit rows and every
# approval decision are NEVER pruned, and records of tasks that are still
# running/paused/blocked are always kept.
# AGENTSCOPE_RETENTION_DAYS="0"

# --- integrations (all optional, all empty by default) -------------------
# Google (Gmail/Calendar/Drive) connector — see docs/GOOGLE_CONNECTOR_SETUP.md
# AGENTSCOPE_GOOGLE_CLIENT_ID=""
# AGENTSCOPE_GOOGLE_CLIENT_SECRET=""
# Outbound e-mail for the host-email tool (SMTP URL).
# AGENTSCOPE_SMTP_URL="smtps://user:password@smtp.example.com:465"
# AGENTSCOPE_SMTP_FROM="jarvis@example.com"
# Telegram remote control (bot token + allowed numeric chat ids).
# AGENTSCOPE_TELEGRAM_BOT_TOKEN=""
# AGENTSCOPE_TELEGRAM_ALLOWED_IDS=""

# --- misc ----------------------------------------------------------------
# Node binary used for the isolated custom-tool runtime.
# AGENTSCOPE_NODE_BINARY="node"
# AGENTSCOPE_SCREEN_WIDTH="1280"
# AGENTSCOPE_SCREEN_MAX_STEPS="20"
# AGENTSCOPE_MORNING_SUMMARY="1"
# AGENTSCOPE_PROACTIVE_DAILY_CAP="5"
# AGENTSCOPE_QUIET_HOURS="23-7"
# AGENTSCOPE_NEWS_FEEDS=""
# AGENTSCOPE_NEWS_LOCALE="en-IN"
# AGENTSCOPE_WORLD_HEADLINES=""
